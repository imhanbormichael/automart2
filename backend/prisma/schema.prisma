generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      String   @default("user")
  createdAt DateTime @default(now())
}

model Car {
  id           Int      @id @default(autoincrement())
  title        String
  make         String
  model        String
  year         Int
  price        Int
  mileage      String
  fuel         String
  transmission String
  condition    String
  location     String
  description  String
  image        String
  sellerName   String
  sellerPhone  String
  sellerEmail  String
  createdAt    DateTime @default(now())
}